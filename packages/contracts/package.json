{
  "name": "@savanna/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts: API response types (generated from OpenAPI) and the custom-element interface.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json --output ./src/generated/api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
