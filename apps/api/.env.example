# Copy to .env and adjust. All variables are prefixed with SAVANNA_.
SAVANNA_ENVIRONMENT=development
SAVANNA_DATABASE_URL=postgresql+asyncpg://savanna:savanna@localhost:5432/savanna
# Comma-separated list of host websites allowed to embed the plugin.
SAVANNA_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Public base URL of static/object storage that hosts media, captions and documents.
SAVANNA_MEDIA_BASE_URL=http://localhost:8080
# Public base URL of this API (used to build transcript links).
SAVANNA_PUBLIC_API_URL=http://localhost:8000
SAVANNA_LOG_LEVEL=INFO
